#!/bin/sh
#
# configure -- tailor the makefile to platforms
#
# No auto*hell crap here. Also, this is called configure but you can modify
# it if you want.
#

IN="Makefile.in"
OUT="Makefile"

PCIN="libreui.pc.in"
PCOUT="libreui.pc"

PREFIX="/usr/local"
VERSION="0.1.0"

TMP_PC="$(mktemp "./.configure.pc.XXXXXX")" || {
	echo "configure: cannot create temporary file" >&2
	exit 1
}

REP_BFILES=""
REP_CPPFLAGS=""
REP_CFLAGS=""
REP_LIBS=""
PKGCONFIG=""

TMP="$(mktemp "./.configure.XXXXXX")" || {
	echo "configure: cannot create temporary file" >&2
	exit 1
}

trap 'rm -f "$TMP" "$TMP_PC"' 0
trap 'exit 1' HUP INT TERM

# Check the Makefile template.
if [ ! -r "$IN" ]; then
	echo "configure: cannot read $IN" >&2
	exit 1
fi

escape_sed()
{
	printf '%s\n' "$1" | sed 's/[\\&|]/\\&/g'
}

case "$(uname -s)" in
	Linux|OpenBSD|FreeBSD|NetBSD)
		echo "configure: using SDL2 backend"

		REP_BFILES="backend/sdl.c"
		REP_CPPFLAGS="-D__UNIX_NOMAC__ -D__UNIX__ -DVERSION=\"$VERSION\""
		;;

	*)
		echo "configure: unsupported platform: $(uname -s)" >&2
		exit 1
		;;
esac

if command -v pkgconf >/dev/null 2>&1; then
	PKGCONFIG="pkgconf"
elif command -v pkg-config >/dev/null 2>&1; then
	PKGCONFIG="pkg-config"
else
	echo "configure: need either pkgconf or pkg-config" >&2
	exit 1
fi

echo "configure: using $PKGCONFIG"

# Check if SDL2 is available.
if ! "$PKGCONFIG" --exists sdl2; then
	echo "configure: SDL2 development files not found" >&2
	exit 1
fi

REP_CFLAGS="$("$PKGCONFIG" --cflags sdl2)" || {
	echo "configure: failed to obtain SDL2 compiler flags" >&2
	exit 1
}

REP_LIBS="$("$PKGCONFIG" --libs sdl2)" || {
	echo "configure: failed to obtain SDL2 linker flags" >&2
	exit 1
}

BFILES_ESC="$(escape_sed "$REP_BFILES")"
CPPFLAGS_ESC="$(escape_sed "$REP_CPPFLAGS")"
CFLAGS_ESC="$(escape_sed "$REP_CFLAGS")"
LIBS_ESC="$(escape_sed "$REP_LIBS")"
PREFIX_ESC="$(escape_sed "$PREFIX")"

for arg in "$@"; do
	case $arg in
		--prefix=*)
			PREFIX="${arg#--prefix=}"
			PREFIX_ESC="$(escape_sed "$PREFIX")"
			;;
		--help)
			echo "reui build system"
			echo "usage: ./configure [--prefix=PREFIX] [--help]"
			exit 0
			;;
		*)
			echo "configure: unknown argument: $arg" >&2
			exit 1
			;;
	esac
done

if ! sed \
	-e "s|@@BACKEND_SRCS@@|$BFILES_ESC|g" \
	-e "s|@@CPPFLAGS@@|$CPPFLAGS_ESC|g" \
	-e "s|@@PREFIX@@|$PREFIX_ESC|g" \
	-e "s|@@CFLAGS@@|$CFLAGS_ESC|g" \
	-e "s|@@LIBS@@|$LIBS_ESC|g" \
	"$IN" > "$TMP"; then
	echo "configure: failed to generate Makefile" >&2
	exit 1
fi

if ! sed \
	-e "s|@@PREFIX@@|$PREFIX_ESC|g" \
	-e "s|@@VERSION@@|$VERSION|g" \
	"$PCIN" > "$TMP_PC"; then
	echo "configure: failed to generate pc file" >&2
	exit 1
fi

if ! mv "$TMP" "$OUT"; then
	echo "configure: failed to write $OUT" >&2
	exit 1
fi

if ! mv "$TMP_PC" "$PCOUT"; then
	echo "configure: failed to write $PCOUT" >&2
	exit 1
fi

echo "configure: created $OUT"
echo "configure: run make to build libreui.a"
