#
# Makefile.in -- build system template
#

CC = cc
AR = ar
ARFLAGS = rcs

TARG = libreui.a
MAN = reui.3
HEADERS = reui/reui.h reui/util.h

PREFIX ?= /usr/local
DESTDIR ?=
LIBDIR ?= ${PREFIX}/lib
INCDIR ?= ${PREFIX}/include
MANDIR ?= ${PREFIX}/man
MAN3DIR ?= ${PREFIX}/man3

# Sources
CFILES = reui.c widgets/widget.c @@BACKEND_SRCS@@
OFILES = ${CFILES:.c=.o}

# Preprocessor and compiler flags
CPPFLAGS = -D_IN_REUI -I. @@CPPFLAGS@@
CFLAGS = -std=c99 -Wall -Werror -fPIC @@CFLAGS@@

.SUFFIXES: .c .o

.PHONY: all clean distclean

all: ${TARG}

.c.o:
	${CC} ${CPPFLAGS} ${CFLAGS} -c $< -o $@

${TARG}: ${OFILES}
	${AR} ${ARFLAGS} ${TARG} ${OFILES}
	echo "note you must use @@LIBS@@ when linking against libreui.a"

clean:
	rm -f ${OFILES} ${OFILES:.o=.d}

distclean: clean
	rm -f ${TARG}

# Dependency files are generated by the compiler.
-include ${OFILES:.o=.d}
