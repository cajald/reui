#
# Makefile.in -- build system template
#

CC = cc
AR = ar
ARFLAGS = rcs

TARG = libreui.a
SHARED = libreui.so.1
MAN = reui.3
HEADERS = reui/reui.h reui/util.h

PREFIX ?= @@PREFIX@@
DESTDIR ?=
LIBDIR ?= ${PREFIX}/lib
INCDIR ?= ${PREFIX}/include
PKGCONFIGDIR ?= ${LIBDIR}/pkgconfig
MANDIR ?= ${PREFIX}/man
MAN3DIR ?= ${PREFIX}/man3

# Sources
CFILES = reui.c widgets/widget.c @@BACKEND_SRCS@@
OFILES = ${CFILES:.c=.o}

# Preprocessor and compiler flags
CPPFLAGS = -D_IN_REUI -I. @@CPPFLAGS@@
CFLAGS = -std=c99 -Wall -Werror -fPIC @@CFLAGS@@

.SUFFIXES: .c .o

.PHONY: all clean distclean install-pc

all: ${TARG} ${SHARED}

.c.o:
	${CC} ${CPPFLAGS} ${CFLAGS} -c $< -o $@

${TARG}: ${OFILES}
	${AR} ${ARFLAGS} ${TARG} ${OFILES}

${SHARED}: ${OFILES}
	${CC} -shared -o ${SHARED} ${OFILES} @@LIBS@@

clean:
	rm -f ${OFILES} ${OFILES:.o=.d} libreui.pc

distclean: clean
	rm -f ${TARG} ${SHARED}

install-pc:
	mkdir -p ${DESTDIR}${PKGCONFIGDIR}
	cp libreui.pc ${DESTDIR}${PKGCONFIGDIR}/

install: install-pc all
	mkdir -p ${DESTDIR}${LIBDIR}
	mkdir -p ${DESTDIR}${INCDIR}/reui
	mkdir -p ${DESTDIR}${MAN3DIR}

	install -m 644 ${TARG} ${DESTDIR}${LIBDIR}
	install -m 755 ${SHARED} ${DESTDIR}${LIBDIR}

	for hdr in ${HEADERS}; do \
		install -m 644 $$hdr ${DESTDIR}${INCDIR}/reui/; \
	done

	install -m 644 ${MAN} ${DESTDIR}${MAN3DIR}/

uninstall:
	rm -f ${DESTDIR}${LIBDIR}/${TARG}
	rm -f ${DESTDIR}${LIBDIR}/${SHARED}
	rm -f ${DESTDIR}${INCDIR}/reui/reui.h
	rm -f ${DESTDIR}${INCDIR}/reui/util.h
	rm -f ${DESTDIR}${MAN3DIR}/${MAN}
	rm -f ${DESTDIR}${PKGCONFIGDIR}/libreui.pc

# Dependency files are generated by the compiler.
-include ${OFILES:.o=.d}

